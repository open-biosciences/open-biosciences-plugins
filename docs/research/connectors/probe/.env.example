# Copy to .env (gitignored). Values for REPRODUCING the frozen Layer-1 benchmark only.
#
# This harness is disposable discovery tooling, not the API layer. Credential
# handling for psychology-mcp lives in that repo's own .env.example — do not
# treat this file as the authoritative place for platform credentials.

# Crossref + OpenAlex polite pools.
PROBE_CONTACT_EMAIL=you@example.com

# Semantic Scholar, sent as `x-api-key`. Needed only to re-run the S2 cells;
# the other four connectors are keyless. See ../01-semantic-scholar.md §1.
S2_API_KEY=s2k-REPLACE_ME
